{
  "name": "ribcage",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:wasm": "cargo build --release --target wasm32-unknown-unknown -p beam-core",
    "build:web": "pnpm build:wasm && node scripts/build-web.mjs",
    "serve": "node scripts/serve.mjs",
    "replay": "node scripts/replay.mjs",
    "test":"pnpm build:wasm && node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
